entity Role;
entity Agent in [Role] {
  tools: Set<String>,
};

entity Call {
  tools: Set<String>,
  all: Bool,
};

type ToolCallContext = {

  tool: String,

  level: Long,
  required_level: Long,

  conf: Long,
  provenance: Set<String>,
  effect: String,
  data_conf: Long,
  sink_clearance: Long,

  denied_tools: Set<String>,
};

action "tool_call";
