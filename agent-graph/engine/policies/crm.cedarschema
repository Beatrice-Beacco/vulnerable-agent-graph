// Roles group agents for grants (e.g. Role::"Analyst").
entity Role;
entity Agent in [Role];

// CRM operation an analysis can describe. evidence: words a request must
// contain for the operation to be derived from it (validation.cedar).
entity Operation {
  evidence: Set<String>,
};

// classification: 0 = PUBLIC, 1 = INTERNAL, 2 = CONFIDENTIAL
entity Field {
  classification: Long,
  name: String,
};

entity Customer;

entity Recipient {
  clearance: Long,
};

type ToolRequestContext = {
  // integrity: 0 = trusted, 1 = untrusted
  integrity: Long,
  // confidentiality: 0 = PUBLIC, 1 = INTERNAL, 2 = CONFIDENTIAL
  conf: Long,
  provenance: Set<String>,
  // Operation binding (binding.cedar). What the executor agent was asked to
  // execute, set by the graph node from the state ("" for other agents)...
  operation: String,
  target_customer: String,
  requested_fields: Set<String>,
  requested_value: String,
  requested_recipient: String,
  // ...and the targets the call itself names.
  call_customer: String,
  call_value: String,
  call_recipient: String,
  // data_subject.cedar: does the call recipient equal the bound customer's
  // own registered address (computed by the monitor from the CRM).
  recipient_is_customer_contact: Bool,
};

// Context of check_analysis: an analysis (structured CRM operation derived
// by an analyst from a request), facts about that request, and the analyst.
type AnalysisContext = {
  // label of the analyst's context
  integrity: Long,
  conf: Long,
  provenance: Set<String>,
  // the analysis (canonical form, engine/facts.py)
  customer_id: String,
  fields: Set<String>,
  field_count: Long,
  value: String,
  recipient: String,
  // the request it was derived from
  request_words: Set<String>,
  request_numbers: Set<String>,
  request_addresses: Set<String>,
  value_in_request: Bool,
  // calls of the analyst the monitor denied during this analysis
  denied_calls: Long,
};

// Context of adopt_analysis: the analysis becomes the operation the
// executors run.
type AdoptionContext = {
  // checked analyses of the same request that describe another operation
  conflicting_analyses: Long,
  // how many of the three operations the request supports by its words
  // (disambiguation.cedar): > 1 means the request is ambiguous
  operations_in_request: Long,
};

// Action groups
action "crm_mutation";  // modifies the CRM: integrity-critical
action "egress";        // moves data to a sink with a clearance

action "read_customer" appliesTo {
  principal: Agent,
  resource: Field,
  context: ToolRequestContext,
};

action "write_customer" in ["crm_mutation", "egress"] appliesTo {
  principal: Agent,
  resource: Field,
  context: ToolRequestContext,
};

action "delete_customer" in ["crm_mutation"] appliesTo {
  principal: Agent,
  resource: Customer,
  context: ToolRequestContext,
};

action "send_email" in ["egress"] appliesTo {
  principal: Agent,
  resource: Recipient,
  context: ToolRequestContext,
};

action "check_analysis" appliesTo {
  principal: Agent,
  resource: Operation,
  context: AnalysisContext,
};

action "adopt_analysis" appliesTo {
  principal: Agent,
  resource: Operation,
  context: AdoptionContext,
};
